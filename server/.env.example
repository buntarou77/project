# База данных
DATABASE_URL=postgres://postgres:postgres@localhost:5432/photo_booking

# Сервер
PORT=3000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173          # CORS allowlist (origin фронтенда)
PUBLIC_BASE_URL=http://localhost:3000     # из него строятся абсолютные URL файлов и ссылок
UPLOADS_DIR=./uploads

# За прокси (nginx) — true: тогда req.ip берётся из X-Forwarded-For.
# Без прокси — false: иначе клиент подделает IP и обнулит rate-limit.
TRUST_PROXY=false

# JWT (openssl rand -base64 48)
JWT_SECRET=

# Модель помощников
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
DAILY_MODEL_BUDGET_RUB=50

# Уведомления (опционально)
SMTP_URL=
# Адрес отправителя (From:). Обязателен для реальных SMTP: mail.ru/yandex
# отклоняют письма, если From не совпадает с аккаунтом.
MAIL_FROM=noreply@example.ru
OWNER_EMAIL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Миграция с Supabase (только для scripts/migrate-from-supabase.ts)
SOURCE_DATABASE_URL=
