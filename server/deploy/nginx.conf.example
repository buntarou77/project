# Nginx: SPA + API на одном домене (лучшая схема по ТЗ §2.4 — cookies без CORS).
# Замените example.ru на ваш домен. Сертификат: certbot --nginx -d example.ru

server {
    listen 80;
    server_name example.ru;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name example.ru;

    # пути появятся после certbot; до него можно слушать только :80 без этого блока
    ssl_certificate     /etc/letsencrypt/live/example.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.ru/privkey.pem;

    # --- фронтенд: собранный dist ---
    root /var/www/app/dist;
    index index.html;

    # --- заголовки безопасности для статики ---
    # add_header не наследуется в location, где есть свой add_header:
    # в location /sw.js список продублирован ниже
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # SPA-роуты (/s/kadr-studio/book и т.п.) → index.html
    location / {
        try_files $uri /index.html;
    }

    # --- API → Express (:3000) ---
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 52m;   # лимиты API: портфолио 3×10 МБ, референсы 5×10 МБ (server/src/middleware/upload.ts)
    }

    # --- файлы портфолио → Express (раздаёт из server/uploads) ---
    location /uploads/ {
        proxy_pass http://127.0.0.1:3000;
    }

    # --- service worker и манифесты per-tenant ---
    location /sw.js {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        try_files $uri =404;
    }
    location /s/ {
        try_files $uri /index.html;
    }
}

# Ограничение доступа: 5432 (Postgres) слушает только localhost — наружу не открывать.
