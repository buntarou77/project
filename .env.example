# === Express API (боевой режим; пусто = демо, затем Supabase) ===
# VITE_API_URL=https://api.example.ru
# В dev можно оставить пустым и использовать vite-прокси (/api → localhost:3000)

# === Supabase (переходный период) ===
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# === Модель для помощников (только серверные функции, не в бандле сайта) ===
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
DAILY_MODEL_BUDGET_RUB=50

# === Уведомления ===
SMTP_URL=
# За прокси (nginx) — true: тогда req.ip берётся из X-Forwarded-For.
# Без прокси — false: иначе клиент подделает IP и обнулит rate-limit.
TRUST_PROXY=false
# Адрес отправителя (From:). Обязателен для реальных SMTP: mail.ru/yandex
# отклоняют письма, если From не совпадает с аккаунтом.
MAIL_FROM=noreply@example.ru
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# === Скрипты управления студиями (tenant:push и т.д.) ===
SUPABASE_DB_URL=
SUPABASE_SERVICE_ROLE_KEY=
PLATFORM_ADMIN_EMAIL=
